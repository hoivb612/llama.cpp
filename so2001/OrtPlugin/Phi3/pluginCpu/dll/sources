TARGETPLATFORM=windows
TARGETTYPE=DYNLINK
TARGETNAME=onnxruntime_providers_fusioncpu

USE_MSVCRT=1
USE_UNICRT=1

USE_STL=1
STL_VER=STL_VER_CURRENT
USE_STD_CPP20=1

USE_NATIVE_EH=1

GUARD=0
INIT_ALL_OPTIN=0

DLLDEF = onnxruntime_providers_fusioncpu.def

# The DLL itself stays at x64 baseline (SSE2) so it loads on non-AVX-512 CPUs.
# All AVX-512 codegen is isolated in the fusioncpu-avx512.lib static library and
# is only entered after a runtime CPU-feature check.
USER_C_FLAGS = \
    $(USER_C_FLAGS) \
    /fp:fast \

!if !defined(MSC_OPTIMIZATION)
MSC_OPTIMIZATION=/O2 /Ob1
!endif

# ORTDROP = the Xbox_uGC_StaticBins vPack payload, pulled once in pass 0 by the shared
# OrtDrop staging dir. The flat ORT headers (onnxruntime_cxx_api.h, etc.) come from
# $(ORTDROP)\inc; the plugin's own headers (version.h, fusion_cpu_ep.h, etc.) stay under
# pluginCpu. This dir gates its pass 1 on OrtDrop|PASS0 via sources.dep.
ORTDROP=$(PROJECT_OBJ_ROOT)\so2001\OrtPlugin\Phi3\OrtDrop\$(O)\drop\OrtDrop

INCLUDES = \
    $(INCLUDES); \
    $(PROJECT_ROOT)\so2001\OrtPlugin\Phi3\pluginCpu; \
    $(ORTDROP)\inc; \

TARGETLIBS = \
    $(TARGETLIBS) \
    $(PROJECT_OBJ_ROOT)\so2001\OrtPlugin\Phi3\pluginCpu\avx512\$(O)\fusioncpu-avx512.lib \
    $(CLIENTCORE_EXTERNAL_SDK_LIB_PATH)\kernel32.lib \

SOURCES = \
    ..\dllmain.cpp \
    ..\fusion_cpu_ep_factory.cpp \
    ..\fusion_cpu_ep.cpp \
    ..\fusion_cpu_extra_ops.cpp \