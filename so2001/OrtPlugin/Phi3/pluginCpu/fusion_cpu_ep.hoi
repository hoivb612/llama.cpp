// thread pool) live in the API-MS-Win-Core-Synch set. Rather than linking
// Synchronization.lib (which is not present in every build environment, e.g.
// the Razzle/OS build), we resolve these three entry points dynamically from
// kernelbase.dll at run time -- see the WaitOnAddressApi helper below. No import
// library is required; the functions exist on every Windows 8 or newer system.
#endif // _WIN32

